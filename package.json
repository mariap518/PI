{
  "name": "sixevent",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "watch": "esbuild src/main.ts --bundle --outfile=app/main.js --loader:.png=file --loader:.jpeg=file --loader:.jpg=dataurl --asset-names=assets/[name] --public-path=./app --format=iife --watch",
    "build": "tsc && esbuild src/main.ts --bundle --minify --outfile=app/main.js --loader:.png=file --loader:.jpeg=file --loader:.jpg=dataurl --asset-names=assets/[name] --public-path=./app --format=iife",
    "typecheck": "tsc",
    "server": "node server/index.mjs",
    "migrate": "node server/migrate.mjs",
    "smoke": "node server/smoke.mjs"
  },
  "dependencies": {
    "@neon/config": "^1.9.4",
    "@neon/env": "^1.6.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0"
  }
}
